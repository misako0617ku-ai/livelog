{
  "functions": {
    "app/api/scrape/starto/route.ts": {
      "maxDuration": 60
    },
    "app/api/scrape/labels/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/sync-labels",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/notify",
      "schedule": "0 20 * * *"
    }
  ]
}
